# SupportOps settings for the optional OrderFlow target.
#
# Copy this file to orderflow.env (git-ignored, like every *.env file) and use it with:
#   uv run supportops --env-file orderflow.env health
#
# SupportOps only reads from OrderFlow: it sends GET requests, reads logs and runs predefined
# read-only SQL. Write requests are refused for this target, even with --yes.
# See docs/integrations/orderflow.md for the full guide.

SUPPORTOPS_TARGET=orderflow

# API-only diagnostics: health, api request (GET only), api latency.
# OrderFlow's Docker Compose app service publishes the API on 127.0.0.1:8080.
SUPPORTOPS_API_URL=http://127.0.0.1:8080

# Bearer tokens expire after 30 minutes, so keep them in an environment variable instead of
# this file and pass --key-env, for example: auth check --key-env ORDERFLOW_TOKEN
# Leave SUPPORTOPS_API_KEY unset unless you have a reason to store a token here.
# SUPPORTOPS_API_KEY=

# Logs: OrderFlow writes ECS JSON when it runs in Docker Compose. The container name below is
# what Compose normally derives from the orderFlow-backend directory; confirm it with
# 'docker ps' and change it if yours differs. A log file path or '-' (stdin) also works.
SUPPORTOPS_LOG_SOURCE=docker:orderflow-backend-app-1

# Database diagnostics: use the dedicated read-only role described in
# docs/integrations/orderflow-readonly-role.sql, never OrderFlow's own database user.
# Replace <password> with the password the administrator set for that role.
# SUPPORTOPS_DB_URL=postgresql://supportops_orderflow_ro:<password>@127.0.0.1:5432/orderflow
